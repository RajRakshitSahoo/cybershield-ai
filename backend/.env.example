# --- Core ---
APP_NAME=CyberShield AI
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# If MONGO_URI is left blank, the app runs on an in-memory mock database
# (mongomock) so it works out of the box without a real MongoDB server.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=cybershield
USE_MOCK_DB=true

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Third-party reputation APIs (all optional, features degrade gracefully) ---
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

# --- Email (for alerts / weekly reports, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@cybershield.ai
